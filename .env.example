RESEARCH_OS_ENV=production
SECRET_KEY=replace-with-a-long-random-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,example.internal
CSRF_TRUSTED_ORIGINS=http://example.internal

POSTGRES_DB=research_os
POSTGRES_USER=research_os
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://research_os:replace-with-a-strong-database-password@postgres:5432/research_os

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_ROOT=/app/storage
PUBLIC_BASE_URL=http://example.internal
PAPER_UPLOAD_ALLOWED_CIDRS=127.0.0.1/32,10.89.0.0/24

MODEL_GATEWAY_PROVIDER=minimax
MODEL_GATEWAY_BASE_URL=https://api.minimaxi.com/v1
MODEL_GATEWAY_API_KEY=
DEFAULT_LLM_MODEL=MiniMax-M2.7
MODEL_GATEWAY_TIMEOUT_SECONDS=60
MODEL_GATEWAY_MAX_TOKENS=1600
MODEL_GATEWAY_CONTEXT_TOKEN_LIMIT=24000
PAPER_DEEP_LLM_TIMEOUT_SECONDS=180
PAPER_DEEP_LLM_MAX_TOKENS=5200
PAPER_DEEP_LLM_EXCERPT_MAX_CHARS=32000
DEFAULT_EMBEDDING_MODEL=

WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_ENDPOINT=http://searxng:8080/search
WEB_SEARCH_TIMEOUT_SECONDS=12

# Production servers should set this in their private .env when route probes are required.
RESEARCH_OS_LAB_ROUTE_PROBES=
